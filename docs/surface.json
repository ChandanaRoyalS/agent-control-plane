      "path": "acp",
      "options": [
        "--version"
      ]
    },
    {
      "path": "acp audit",
      "options": []
    },
    {
      "path": "acp audit checkpoint",
      "options": [
        "--checkpoint",
        "--log-file"
      ]
    },
    {
      "path": "acp audit verify",
      "options": [
        "--checkpoint",
        "--log-file"
      ]
    },
    {
      "path": "acp call",
      "options": [
        "--args",
        "--connect-timeout",
        "--name",
        "--read-timeout",
        "--tool",
        "--url"
      ]
    },
    {
      "path": "acp policy",
      "options": []
    },
    {
      "path": "acp policy explain",
      "options": [
        "--actor",
        "--arg",
        "--policy",
        "--subject",
        "--tool"
      ]
    },
    {
      "path": "acp policy simulate",
      "options": [
        "--log",
        "--policy",
        "--show"
      ]
    },
    {
      "path": "acp probe",
      "options": [
        "--connect-timeout",
        "--name",
        "--read-timeout",
        "--url"
      ]
    },
    {
      "path": "acp schemas",
      "options": []
    },
    {
      "path": "acp schemas capture",
      "options": [
        "--allow-partial",
        "--baseline",
        "--upstreams-file"
      ]
    },
    {
      "path": "acp schemas check",
      "options": [
        "--baseline",
        "--upstreams-file"
      ]
    },
    {
      "path": "acp secrets",
      "options": []
    },
    {
      "path": "acp secrets init",
      "options": [
        "--force",
        "--key-file",
        "--secrets-file"
      ]
    },
    {
      "path": "acp secrets list",
      "options": [
        "--key-file",
        "--secrets-file"
      ]
    },
    {
      "path": "acp secrets set",
      "options": [
        "--key-file",
        "--secrets-file"
      ]
    },
    {
      "path": "acp serve",
      "options": [
        "--host",
        "--port",
        "--upstreams-file"
      ]
