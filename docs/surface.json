  "audit": {
    "version": [
      "acp-audit-v1"
    ],
    "categories": [
      "approval",
      "authorization",
      "credential",
      "firewall",
      "tool_call"
    ],
    "outcomes": [
      "allowed",
      "completed",
      "denied",
      "failed",
      "held"
    ],
    "fields": [
      "category",
      "event",
      "at",
      "subject",
      "actor",
      "tenant",
      "tool",
      "upstream",
      "rule",
      "outcome",
      "reason",
      "detail"
    ]
