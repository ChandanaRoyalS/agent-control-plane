# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
.python-version

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# Type checking
.mypy_cache/
.ruff_cache/

# Secrets — never commit these. See docs/decisions/0004 for the config approach.
.env
.env.*
!.env.example
*.pem
*.key
/secrets/

# The encrypted secret store and the one key that opens it (task 29). The store
# is ciphertext, so committing it would not expose a value directly — and it
# would put every credential the gateway holds into every clone, every fork and
# every backup, waiting for the key to leak once. Neither belongs in git.
*.enc
config/secret.key
config/secrets.enc

# Editors
.vscode/
.idea/
*.swp
.DS_Store
