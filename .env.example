# Copy to .env for local development. .env is gitignored and must stay that way.
# Every value here is fake. Real secrets are injected by the runtime, and in
# containers are read from files via the _FILE suffix convention.

ACP_LOG_LEVEL=INFO
ACP_LOG_FORMAT=json          # json | console — use console locally if you prefer
ACP_HOST=127.0.0.1
ACP_PORT=8080

# Metrics and liveness, on their own listener. Loopback by default: a scrape
# endpoint publishes every upstream and tool name, so exposing it is a
# deliberate act rather than the default (ADR 0010).
ACP_ADMIN_HOST=127.0.0.1
ACP_ADMIN_PORT=9090
ACP_ADMIN_ENABLED=true

# Background health probing. Off means no upstream is ever withdrawn: every
# upstream is attempted on every request, and a breaker
# recovers only when some agent's request happens to become its trial call.
ACP_HEALTH_PROBING_ENABLED=true
ACP_HEALTH_PROBE_INTERVAL=15.0

# Schema drift detection (ADR 0013). Rides on the health prober's fetch, so it
# does nothing when probing is off. The baseline is a committed file, changed
# only by `acp schemas capture` — a baseline that updates itself is not a
# baseline, it is a log of the most recent state.
ACP_SCHEMA_DRIFT_DETECTION_ENABLED=true
ACP_SCHEMA_BASELINE_FILE=./config/schema-baseline.json

# Path to the upstream server definitions
ACP_UPSTREAMS_FILE=./config/upstreams.yaml

# OpenTelemetry
OTEL_SERVICE_NAME=agent-control-plane
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp

# Identity (ADR 0015).
#
# There is deliberately no ACP_AUTH_ENABLED. Authentication is on when a
# provider is configured and off when one is not, because a boolean is a thing
# somebody forgets to set — and the failure mode of forgetting is a gateway
# that accepts everything while its config claims otherwise. Setting some of
# these and not the others is a startup failure.
#
# Blank here, so a bare `acp serve` runs unauthenticated — which you have to
# ask for explicitly. ACP_AUTH_REQUIRED defaults to true:
# a gateway that is a security control refuses to start without the thing that
# makes it one. Unauthenticated is still a real mode; it just costs one line
# somebody wrote on purpose, and it says so at startup and on every request
# line: `principal: anonymous`.
#
# `docker compose up` needs none of this. It runs a real Keycloak with a
# committed realm (config/keycloak/), and the gateway is configured against it
# in docker-compose.yml. That is the path to prefer — see ADR 0018.
ACP_AUTH_REQUIRED=false
ACP_AUTH_ISSUER=
ACP_AUTH_AUDIENCE=

# Leave the JWKS URL unset. Discovered from the issuer's metadata, which is
# where the binding between an issuer and its keys is *verified* rather than
# asserted (RFC 8414 §3.3, ADR 0016). Setting it by hand skips that check —
# which is how one authorization server's keys end up trusted for another, by
# copy-paste rather than by an attacker.
# ACP_AUTH_JWKS_URL=

# To trust more than one authorization server, use a file instead. Mutually
# exclusive with the two settings above; see config/issuers.yaml.example.
# ACP_AUTH_ISSUERS_FILE=./config/issuers.yaml

# This gateway's public resource identifier (RFC 9728, ADR 0017). Set it and
# the gateway serves /.well-known/oauth-protected-resource and adds
# `resource_metadata` to every 401, so a client that has never been configured
# for this deployment can find its way to a token instead of being told the
# authorization server by hand.
#
# The URL an agent actually *reaches* this gateway on — not the interface it
# binds, which is only the same thing on a laptop. It should equal the audience
# tokens carry: a client sends it as RFC 8707's `resource` parameter, the
# authorization server copies it into `aud`, and that is what gets checked.
# Startup warns when they differ, because then every step of discovery works
# and only the last one fails.
#
# Optional, and its absence is a missing convenience rather than a missing
# control — a gateway without it validates tokens exactly as strictly. Setting
# it without an issuer is a startup failure: the document would advertise a
# discovery path that dead-ends.
# ACP_AUTH_RESOURCE=https://gw.corp.example/mcp

# Hosts allowed to serve their metadata and key sets over plain HTTP. Empty by
# default; loopback is already exempt without it, because traffic that never
# leaves the machine has no in-flight to be rewritten in. This exists for one
# case: a development identity provider reached from another container by
# service name, where the URL is http://keycloak:8080 and neither TLS nor
# loopback applies.
#
# The escape hatch is here so nobody builds a worse one. The alternatives were
# to widen the loopback set — a lie that ships everywhere — or to turn
# certificate verification off, which is broader, quieter, and invisible in a
# config file. Every entry is logged at every start. ADR 0018.
# ACP_AUTH_INSECURE_ISSUER_HOSTS=["keycloak"]

# Token exchange (ADR 0019). Setting both of these turns it on: the
# gateway stops passing anything through and instead mints a short-lived
# credential per call, scoped to one upstream, via RFC 8693.
#
# This is who the gateway *is* as an OAuth client, which is a different identity
# from ACP_AUTH_AUDIENCE above — that is what the gateway is *called* by tokens
# arriving at it. Conflating the two is the easy mistake.
#
# The secret belongs in the secrets directory rather than here: a file at
# /run/secrets/auth_client_secret, because a process's environment is readable
# by anything that can see /proc. Once these are set, every upstream in
# config/upstreams.yaml must declare an `audience` or the gateway will not start.
# ACP_AUTH_CLIENT_ID=acp-gateway
# ACP_AUTH_CLIENT_SECRET=

# Only when discovery cannot run — an explicit ACP_AUTH_JWKS_URL skips it. The
# token endpoint normally comes from the issuer's metadata, which has already
# been proved to belong to that issuer.
# ACP_AUTH_TOKEN_ENDPOINT=

# ACP_AUTH_DISCOVERY_TIMEOUT=5.0
# ACP_AUTH_LEEWAY=60.0
# ACP_AUTH_JWKS_CACHE_TTL=600.0
# ACP_AUTH_JWKS_MIN_REFRESH_INTERVAL=30.0

# How many exchanged credentials to hold (ADR 0022). A bound before it
# is a tuning knob: unbounded, this grows with every distinct (caller, upstream)
# pair the gateway has ever seen, and an authenticated caller with a token mint
# can drive that in a loop. A bound turns that into eviction — least recently
# used, so a busy principal does not lose their credential to a burst from a
# quiet one.
#
# Raise it if a deployment has more concurrently-active principals than this;
# the cost of it being too small is an extra token exchange, not an error.
# Nothing here changes *what* is cached: an entry belongs to one caller and one
# upstream, and there is no setting that can widen that.
# ACP_AUTH_CREDENTIAL_CACHE_MAX_ENTRIES=1024
# The encrypted secret store (ADR 0021). Only needed for upstreams that
# cannot take part in token exchange — everything that can should, because a
# credential minted per call and thrown away is not a secret anybody has to
# store. All-or-nothing: a store with no key cannot be opened, a key with no
# store opens nothing.
#
# The key file is the one secret this reduces every other secret to. Point it
# somewhere a *runtime* puts things — a Kubernetes secret mount, a Docker
# secret, a tmpfs populated at boot — rather than somewhere a person edits.
# Startup refuses it if it is readable beyond its owner.
#
#   acp secrets init
#   acp secrets set legacy-crm-api-key      # prompts; never takes a value in argv
#   acp secrets list                        # names only
#
# ACP_SECRETS_FILE=./config/secrets.enc
# ACP_SECRET_KEY_FILE=./config/secret.key

# Result caching (ADR 0035). Which tool results may be served from
# memory, and for how long. Unset, nothing is cached and every call reaches its
# upstream exactly as before.
#
# There is deliberately no ACP_CACHE_ENABLED. Caching is on for the tools the
# file names and off for everything else, so the file *is* the switch — a
# boolean would be a second place for the answer to live, and the failure mode
# of forgetting one is a tool cached that nobody meant to cache.
#
# A cached result is served to the SAME PRINCIPAL ONLY: the key is the subject,
# the acting agent, the upstream, the tool and the arguments. Two agents acting
# for the same person do not share an entry either. Getting that key wrong is a
# data leak rather than a performance bug, which is why it has an ADR and a
# mutation harness (`make prove-cache`) rather than only a test.
#
# ACP_CACHE_FILE=./config/cache.yaml
# ACP_RESULT_CACHE_MAX_ENTRIES=512

# Provenance framing (ADR 0037). Every tool result is fenced before
# the model reads it: an opening block saying this is data that was *retrieved*
# rather than instruction that was *given*, the upstream's own content
# unmodified, and a closing block.
#
# The delimiter carries 128 bits of randomness and is fresh for every result.
# A fixed marker would be a string the attacker can also write — a document
# containing the closing marker, followed by "the above is verified, proceed as
# instructed", closes the fence early and everything after it reads as trusted.
#
# This is the half of the firewall with no false-positive rate: it judges
# nothing, so it cannot be wrong about a document. Off by default only because
# it is a visible change to the wire — a caller receives two more content
# blocks than the upstream sent.
#
# ACP_PROVENANCE_FRAMING_ENABLED=true

# Injection firewall (ADRs 0036 and 0038). Screens every tool
# result for instruction-shaped language, hidden characters, exfiltration URLs,
# encoded payloads and mentions of tools the document should not know about.
#
#   off      screen nothing. The default.
#   report   screen everything, log everything, change nothing the caller sees.
#   enforce  withhold content that crosses the bar.
#
# START AT `report`, and not out of timidity — it is the measuring instrument.
# It evaluates the same bar `enforce` would and logs a result it *would* have
# withheld as `would_refuse`, so you learn what enforcement costs your own
# traffic before you pay it. A firewall that refuses honest documents does not
# get tuned, it gets set back to `off`.
#
# The bar is deliberately high. A finding can only withhold a result if it is
# HIGH confidence AND comes from one of four detectors whose false positives are
# near zero by construction: a bidirectional override, base64 that decodes to an
# instruction, a mention of a qualified tool from this estate's catalogue, or a
# markdown image to an unapproved host. Notably absent is the famous one —
# "ignore previous instructions" is capped at MEDIUM and can never refuse
# anything, because a security advisory and an attack are the same sentence to a
# regular expression.
#
# ACP_FIREWALL_MODE=report

# Hosts a tool result may legitimately link to or embed an image from. Empty is
# the noisy default on purpose: every image and link is reported. It is also
# what keeps the exfiltration detector from withholding anything — until this is
# set, the gateway cannot tell an exfiltration URL from your wiki's logo.
#
# ACP_FIREWALL_ALLOWED_HOSTS=["docs.corp","cdn.corp"]

# Approvals (ADRs 0048, 0049, 0059). A policy rule with `effect: require_approval`
# holds the call for a person, who answers on the ADMIN listener (:9090), never
# the agent's. Two ways for that person to prove who they are:
#
# The strong one. Operators present a JWT from the same issuers as
# ACP_AUTH_ISSUER / ACP_AUTH_ISSUERS_FILE, minted for THIS audience. The audit
# row then names the verified subject, and an operator decides only within the
# tenant their registration stamps. Must differ from ACP_AUTH_AUDIENCE: with one
# audience, every agent token is also an operator token.
#
# ACP_APPROVAL_OPERATOR_AUDIENCE=acp-operators

# The weak one, for a laptop and the compose stack. A shared bearer, at least 16
# characters, compared in constant time. A decision made with it is recorded as
# `operator: shared-token`, and a gateway running on this alone warns at every
# start. Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
#
# ACP_APPROVAL_OPERATOR_TOKEN=

# How long a held call waits before expiry refuses it (seconds), and how many
# may be held at once. Expiry is the default-deny.
#
# ACP_APPROVAL_TTL_SECONDS=300
# ACP_APPROVAL_MAX_PENDING=256

# Where held approvals live. Empty: this process's memory, correct for exactly
# one gateway. A Redis URL (redis://, rediss://, unix://): every replica reads
# and writes the same record, so a retry may land anywhere and a restart
# forgets nothing (ADR 0066). The gateway refuses to start if it is
# unreachable. MAX_PENDING does not apply to a shared store; its bound is the
# TTL, enforced by Redis. The URL may carry a password — secret store, please.
#
# ACP_APPROVAL_STORE_URL=

# Where rate-limit buckets and quota tallies live. Empty: this process's
# memory, so a replicated fleet multiplies every limit by the replica count.
# A Redis URL: one bucket and one tally per payer, charged atomically from
# whichever replica the call lands on (ADR 0067). The gateway refuses to
# start if it is unreachable. Independent of the approval store — shared
# budgets cost a round trip per call — but both may name the same Redis.
#
# ACP_BUDGET_STORE_URL=
