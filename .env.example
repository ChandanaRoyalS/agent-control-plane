# Copy to .env for local development. .env is gitignored and must stay that way.
# Every value here is fake. Real secrets are injected by the runtime, and in
# containers are read from files via the _FILE suffix convention.

ACP_LOG_LEVEL=INFO
ACP_LOG_FORMAT=json          # json | console — use console locally if you prefer
ACP_HOST=127.0.0.1
ACP_PORT=8080

# Metrics and liveness, on their own listener. Loopback by default: a scrape
# endpoint publishes every upstream and tool name, so exposing it is a
# deliberate act rather than the default (ADR 0010).
ACP_ADMIN_HOST=127.0.0.1
ACP_ADMIN_PORT=9090
ACP_ADMIN_ENABLED=true

# Background health probing. Off means the gateway behaves as it did before
# task 18: every upstream is attempted on every request, and a breaker
# recovers only when some agent's request happens to become its trial call.
ACP_HEALTH_PROBING_ENABLED=true
ACP_HEALTH_PROBE_INTERVAL=15.0

# Path to the upstream server definitions (Phase 1)
ACP_UPSTREAMS_FILE=./config/upstreams.yaml

# OpenTelemetry (Phase 1)
OTEL_SERVICE_NAME=agent-control-plane
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp

# Identity (Phase 2) — left blank until that phase lands
ACP_OIDC_ISSUER=
ACP_OIDC_AUDIENCE=
# ACP_CREDENTIAL_STORE_KEY_FILE=/run/secrets/credential_store_key

# Redis for budgets (Phase 4)
# ACP_REDIS_URL=redis://localhost:6379/0
